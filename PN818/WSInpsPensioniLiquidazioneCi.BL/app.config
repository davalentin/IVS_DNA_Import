<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="wsDelegheSindacaliSoap">
                    <security>
                        <message algorithmSuite="Default" />
                    </security>
                </binding>
                <binding name="BasicHttpBinding_IGestionePecoService" closeTimeout="00:01:00"
                    openTimeout="00:01:00" receiveTimeout="00:10:00" sendTimeout="00:01:00"
                    allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard"
                    maxBufferPoolSize="524288" maxBufferSize="65536" maxReceivedMessageSize="65536"
                    textEncoding="utf-8" transferMode="Buffered" useDefaultWebProxy="true"
                    messageEncoding="Text">
                    <readerQuotas maxDepth="32" maxStringContentLength="8192" maxArrayLength="16384"
                        maxBytesPerRead="4096" maxNameTableCharCount="16384" />
                    <security mode="None">
                        <transport clientCredentialType="None" proxyCredentialType="None"
                            realm="" />
                        <message clientCredentialType="UserName" algorithmSuite="Default" />
                    </security>
                </binding>
                <binding name="AllegatiConvenzioniServiceSOAPBinding" messageEncoding="Mtom" />
                <binding name="AnfWSPortBinding" />
                <binding name="AllegatiConvenzioniServiceSOAP" />
                <binding name="WSSERVIZINACIPortBinding" />
            </basicHttpBinding>
            <customBinding>
                <binding name="wsDelegheSindacaliSoap12">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpTransport />
                </binding>
            </customBinding>
        </bindings>
        <client>
            <endpoint address="http://192.168.40.157:80/Ws.Net/WSGestionePeco"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IGestionePecoService"
                contract="SrvAggPec.IGestionePecoService" name="BasicHttpBinding_IGestionePecoService" />
            <endpoint address="http://192.168.40.154:80/Ws.Net/WSDelegheSindacali"
                binding="basicHttpBinding" bindingConfiguration="wsDelegheSindacaliSoap"
                contract="SrvDelegheSindacali.wsDelegheSindacaliSoap" name="wsDelegheSindacaliSoap" />
            <endpoint address="http://192.168.40.154:80/Ws.Net/WSDelegheSindacali"
                binding="customBinding" bindingConfiguration="wsDelegheSindacaliSoap12"
                contract="SrvDelegheSindacali.wsDelegheSindacaliSoap" name="wsDelegheSindacaliSoap12" />
            <endpoint address="https://ws.svil.inps/WsJava/WSAllegatiConvenzioni/AllegatiConvenzioniService"
                binding="basicHttpBinding" bindingConfiguration="AllegatiConvenzioniServiceSOAPBinding"
                contract="SvrAllegatiConvenzioni.AllegatiConvenzioniService"
                name="AllegatiConvenzioniServiceSOAP" />
            <endpoint address="http://aixwbstest3.ser-test.inps:80/AnfWSWEB/AnfWS"
                binding="basicHttpBinding" bindingConfiguration="AnfWSPortBinding"
                contract="SrvANF.AnfWS" name="AnfWSPort" />
            <endpoint address="http://192.168.40.149:80/WsJava/WSAllegatiConvenzioni/AllegatiConvenzioniService"
                binding="basicHttpBinding" bindingConfiguration="AllegatiConvenzioniServiceSOAP"
                contract="SrvAllegatiConvenzioni.AllegatiConvenzioniService"
                name="AllegatiConvenzioniServiceSOAP1" />
            <endpoint address="http://192.168.41.167:8082/WSSERVIZINACI/WSSERVIZINACIService"
                binding="basicHttpBinding" bindingConfiguration="WSSERVIZINACIPortBinding"
                contract="SrvNACI.WSSERVIZINACIService" name="WSSERVIZINACIPort" />
        </client>
    </system.serviceModel>
</configuration>